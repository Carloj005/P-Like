(* Ordinamento Selection Sort e verifica array_ordinato - Slide Prof. Laccetti *)

procedure selection_sort(in: n; in/out: A)
    var: i, j, n, p: integer
    var: A: array [1..100] of real
    var: min_val, tmp: real
begin
    for i := 1 to n - 1 do
        min_val := A(i)
        p := i
        for j := i + 1 to n do
            if (A(j) < min_val) then
                min_val := A(j)
                p := j
            endif
        endfor
        tmp := A(i)
        A(i) := A(p)
        A(p) := tmp
    endfor
end selection_sort

function array_ordinato(in: A, n): logical
    var: i, n: integer
    var: A: array [1..100] of real
begin
    i := 1
    while (i < n .AND. A(i) <= A(i + 1)) do
        i := i + 1
    endwhile
    if (i = n) then
        array_ordinato := .TRUE.
    else
        array_ordinato := .FALSE.
    endif
end array_ordinato

begin test_selection_sort
    var: V: array [1..6] of real
    var: i: integer

    V(1) := 12.5
    V(2) := 3.0
    V(3) := 9.5
    V(4) := 1.0
    V(5) := 7.2
    V(6) := 4.8

    print 'Ordinato prima:', array_ordinato(V, 6)
    selection_sort(6, V)
    print 'Ordinato dopo:', array_ordinato(V, 6)
    for i := 1 to 6 do
        print V(i)
    endfor
end test_selection_sort
