(* Merge tra 2 array ordinati - Slide Prof. Giuliano Laccetti *)

procedure merge_tra_2Array_ordinati(in: A, B, n, m; out: C)
    var: i, j, k, h, n, m: integer
    var: A: array [1..100] of integer
    var: B: array [1..100] of integer
    var: C: array [1..200] of integer
begin
    i := 1
    j := 1
    k := 1
    while (i <= n .AND. j <= m) do
        if (A(i) < B(j)) then
            C(k) := A(i)
            i := i + 1
        else
            C(k) := B(j)
            j := j + 1
        endif
        k := k + 1
    endwhile

    if (i > n) then
        /* array A esaurito */
        for h := j to m do
            C(k) := B(h)
            k := k + 1
        endfor
    else
        /* array B esaurito */
        for h := i to n do
            C(k) := A(h)
            k := k + 1
        endfor
    endif
end merge_tra_2Array_ordinati

begin test_merge
    var: A: array [1..4] of integer
    var: B: array [1..3] of integer
    var: C: array [1..7] of integer
    var: i: integer

    A(1) := 2; A(2) := 7; A(3) := 11; A(4) := 15
    B(1) := 1; B(2) := 11; B(3) := 19

    merge_tra_2Array_ordinati(A, B, 4, 3, C)
    print 'Merge ordinato:'
    for i := 1 to 7 do
        print C(i)
    endfor
end test_merge
